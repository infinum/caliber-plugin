{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(submit_audit|verify_spec)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/stamp-invoker.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/agent-post-push.sh claude plugin",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/agent-post-push.sh claude plugin session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
