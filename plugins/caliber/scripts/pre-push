#!/bin/sh
# Caliber check on push: the git hook. caliber-hooks-version: 18
# Written by /caliber:setup. Do not edit: the next version replaces the file whole.
#
# git runs this before a push, after the hook that was there. It never blocks, delays or
# fails a push: it starts the check (check-on-push.sh) or a virtual clone's sync in the
# background.
#
#   .caliber/hooks/pre-push --install
#       turn the check on for this clone: records its endpoint and copies the hook files
#       to <git common dir>/caliber/hooks/ (run again after the hooks change)
#   git config --local caliber.checkOnPush false    turn it off (true: on again)
#   <this file> --install --virtual [--repository host/owner/name]
#       turn the sync on for a virtual repository; the sync token comes on stdin
#   <this file> --install --virtual --session-only [--repository host/owner/name]
#       the same with no copy and no git hook: the plugin's session hook syncs
#   <git common dir>/caliber/hooks/pre-push --sync [--full | --backfill]
#       send what is new now; --full: the whole history; --backfill: once, in the
#       background, the history from the date the server names
#   git config --local caliber.syncActivity false    turn the sync off
#
# The check runs with CALIBER_TOKEN, else with the Caliber plugin of Claude Code.
# Only a copy outside the working tree (the git directory's or the plugin's) sends the
# token or runs the check: a branch checked out may change the working tree.
# The sync sends commits, pull requests, tags and branch fingerprints, authors hashed,
# text only if the organisation keeps it. Log: <git common dir>/caliber/sync.log; token
# and state: <git common dir>/caliber/.

MARK='# caliber:check-on-push'

say() { printf 'Caliber: %s\n' "$*" >&2; }

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
here=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P) || exit 0

# The endpoint to record. `endpoint virtual` never reads the MCP configs: a virtual
# repository's working tree must not choose where the token goes. (Each Python script
# here is a function body: bash 3.2 misreads a here-document inside $(...).)
endpoint() {
  CALIBER_BASE=${CALIBER_URL:-https://app.caliberhq.io} CALIBER_CONFIGS=${1:-repository} \
    CALIBER_PINNED=${pinned:-} python3 -I - <<'PY'
import json
import os
import re
from urllib.parse import urlsplit


def plain(url):
    """A plain URL only: it is stored, printed and sent a token."""
    try:
        parts = urlsplit(url)
    except ValueError:
        return False
    host = parts.hostname or ""
    local = host in ("localhost", "127.0.0.1", "::1")
    return bool(re.fullmatch(r"https?://[A-Za-z0-9.\-:\[\]]+(/[A-Za-z0-9._~/%\-]*)?", url)) \
        and (parts.scheme == "https" or (parts.scheme == "http" and local)) and bool(host) \
        and parts.username is None and parts.password is None


def shown(url):
    """Without user and password; not at all when an `@` is left."""
    bare = re.sub(r"^([A-Za-z][A-Za-z0-9+.-]*://)[^/]*@", r"\1", url)
    return "not shown: it holds an @" if "@" in bare else bare


pinned = os.environ["CALIBER_PINNED"]
if pinned and not plain(pinned):
    print("bad-pin " + shown(pinned))
    raise SystemExit(0)
named = False
# The project MCP files setup writes the URL into.
configs = () if os.environ["CALIBER_CONFIGS"] == "virtual" else (
    (".mcp.json", "mcpServers"), (".cursor/mcp.json", "mcpServers"),
    (".vscode/mcp.json", "servers"), (".github/mcp.json", "mcpServers"),
    (".pi/mcp.json", "mcpServers"), (".omp/mcp.json", "mcpServers"),
    (".junie/mcp/mcp.json", "mcpServers"), (".gemini/settings.json", "mcpServers"))
for path, key in configs:
    try:
        with open(path) as fh:
            server = (json.load(fh).get(key) or {}).get("caliber") or {}
        url = server.get("url") or server.get("serverUrl") or server.get("httpUrl")
    except (OSError, ValueError, AttributeError, TypeError):
        continue
    if not isinstance(url, str):
        continue
    if plain(url):
        print("config " + url)
        raise SystemExit(0)
    named = True
if named:
    print("refused")
else:
    url = os.environ["CALIBER_BASE"].rstrip("/") + "/mcp"
    print(("default " + url) if plain(url) else "bad-env " + shown(os.environ["CALIBER_BASE"]))
PY
}

# keep <hook> <mark> <where>: puts CALIBER_LINE in the hook, prints what it did.
keep() {
  python3 -I - "$@" <<'PY'
import os
import re
import sys

path, mark, where = sys.argv[1], sys.argv[2], sys.argv[3]
line = os.environ["CALIBER_LINE"]
previous = path + ".caliber-previous"
#: The wrapper's version: an older wrapper of ours is replaced.
VERSION = 8
# In the clone's own hooks directory the hook that was there is never edited: it is kept
# under another name and runs first, whatever its language; its result decides the push.
WRAPPER = """#!/bin/sh
%s
# caliber-wrapper: %d
# Written by .caliber/hooks/pre-push --install. The hook that was here before, if any,
# is pre-push.caliber-previous: it runs first, with what git sent, and decides the push.
# After a success, in a clone that turned it on, the Caliber check of the pushed commit
# starts in the background, and in a clone of a virtual repository the activity sync.
# To undo: delete this file and rename pre-push.caliber-previous back to pre-push.
here=$(dirname "$0")
refs=$(cat)
feed() { [ -z "$refs" ] || printf "%%s\\n" "$refs"; }
if [ -x "$here/pre-push.caliber-previous" ]; then
  feed | "$here/pre-push.caliber-previous" "$@" || exit $?
fi
on() { [ "$(git config --local --type=bool --get "caliber.$1" 2>/dev/null)" = true ]; }
on checkOnPush || on syncActivity || exit 0
# No file of the working tree runs: it is what the checked-out branch holds (a branch
# someone else wrote, or in a clone of a virtual repository the client's). The copy in the
# git directory, which --install made and no checkout, merge or pull writes, starts the
# check and the sync.
common=$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P) || exit 0
caliber_hook="$common/caliber/hooks/pre-push"
if [ ! -x "$caliber_hook" ]; then
  # The sync alone has its session route (the Caliber plugin's own copy); the check has none.
  ! on checkOnPush || echo "Caliber: no background check from this hook: this clone has no copy of Caliber's hook in its git directory. Run .caliber/hooks/pre-push --install once more (or /caliber:setup)." >&2
  exit 0
fi
feed | "$caliber_hook" "$@" || true
exit 0
""" % (mark, VERSION)
# A hook that reads its own name or path breaks under another name (best effort).
DOLLAR = b"\x24"
ITSELF = (DOLLAR + b"0", DOLLAR + b"\x7b0", b"BASH_SOURCE", b"BASH_ARGV0", b"ZSH_ARGZERO",
          b"argv", b"__file__", b"__FILE__", b"__filename", b"import.meta", b"PROGRAM_NAME",
          b"os.Args", b"PSCommandPath", b"MyInvocation")


def write(text):
    with open(path, "w") as fh:
        fh.write(text)
    os.chmod(path, 0o755)


exists = os.path.lexists(path)
link = os.path.islink(path)
data = None
if exists and not link and os.path.isfile(path):
    with open(path, "rb") as fh:
        data = fh.read()
# Ours from another version: the wrapper, or a versioned hook created with its one line.
OURS = b"# Written by .caliber/hooks/pre-push --install."
if data is not None and mark.encode() in data and where != "shared":
    found = re.search(rb"^# caliber-wrapper: ([0-9]+)$", data, re.M)
    version = int(found.group(1)) if found else 5
    if where == "own" and data.startswith(b"#!/bin/sh\n" + mark.encode() + b"\n") \
            and OURS in data and (version < VERSION
                                  or (version == VERSION and data != WRAPPER.encode())):
        write(WRAPPER)
        print("updated")
        sys.exit(0)
    created = data.decode("utf-8", "replace").split("\n")
    if where == "versioned" and len(created) == 3 and created[0] == "#!/bin/sh" \
            and created[1].endswith(mark) and created[1] != line and created[2] == "":
        with open(path, "w") as fh:
            fh.write("#!/bin/sh\n" + line + "\n")
        print("updated")
        sys.exit(0)
    # Our older line in a team's hook: replaced, nothing else changes.
    ours = [k for k, text_line in enumerate(created)
            if text_line.startswith("caliber_rc=$?; ") and text_line.endswith(" " + mark)]
    if where == "versioned" and len(ours) == 1 and created[ours[0]] != line:
        created[ours[0]] = line
        with open(path, "w") as fh:
            fh.write("\n".join(created))
        print("updated")
        sys.exit(0)
if data is not None and mark.encode() in data:
    print("already")                    # shared too: someone added it
    sys.exit(0)
if where == "shared":
    print("shared")
    sys.exit(0)
if not exists:
    write(WRAPPER if where == "own" else "#!/bin/sh\n" + line + "\n")
    print("created")
    sys.exit(0)
if data is None:
    print("special")                    # a symbolic link or a directory
    sys.exit(0)
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    text = None
if where == "own":
    if os.path.lexists(previous):
        print("taken")
    elif text is None or "\0" in text or any(word in data for word in ITSELF):
        print("itself")
    else:
        os.rename(path, previous)       # mode too: a hook that was off stays off
        write(WRAPPER)
        print("wrapped")
    sys.exit(0)
# A versioned hook is the team's: the line goes only where it is plainly reached.
if text is None or "\0" in text:
    print("foreign")
    sys.exit(0)
lines = text.split("\n")
if lines[0].startswith("#!") and not re.search(r"(^|[/\s])(sh|bash|dash|zsh|ksh)(\s|$)", lines[0][2:]):
    print("foreign")
    sys.exit(0)
while lines and not lines[-1].strip():
    lines.pop()
code = [text_line for text_line in lines if not text_line.lstrip().startswith("#")]
if any(re.search(r"\b(exec|exit)\b", text_line) for text_line in code) \
        or (lines and lines[-1].rstrip().endswith("\\")):
    print("flow")
    sys.exit(0)
lines.append(line)
with open(path, "w") as fh:
    fh.write("\n".join(lines) + "\n")
print("added")
PY
}

sync_run() {
  python3 -I "$here/sync.py" "$@"
}

# The pushed branches' local shas from $refs, one word each. (A function: bash 3.2
# misreads a `case` inside $(...).)
pushed_shas() {
  printf '%s\n' "$refs" | while read -r _ local_sha remote_ref _; do
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    case "$local_sha" in *[!0-9a-f]* | "") continue ;; *[!0]*) printf '%s ' "$local_sha" ;; esac
  done
}

# The pushing git process, which the sync waits for (empty if unknown).
pushing_git() {
  ps -A -o pid= -o ppid= -o comm= 2>/dev/null | awk -v start="$PPID" '
    { parent[$1] = $2; name[$1] = $3 }
    END {
      p = start
      for (i = 0; i < 8 && p > 1; i++) {
        n = name[p]; sub(/.*\//, "", n)
        if (n == "git") { print p; exit }
        p = parent[p]
      }
    }'
}

if [ "${1:-}" = "--sync" ]; then
  shift
  [ "$(git config --local --type=bool --get caliber.syncActivity 2>/dev/null)" = true ] || exit 0
  common=$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P) || exit 0
  # Only a copy outside the working tree sends the token. One in it (a merge may have put
  # it there) hands over to the git directory's copy, or ends.
  if [ "$here" != "$common/caliber/hooks" ]; then
    tree=$(cd "$root" 2>/dev/null && pwd -P) || exit 0
    case "$here/" in
      "$tree/"*)
        [ -x "$common/caliber/hooks/pre-push" ] || exit 0
        exec "$common/caliber/hooks/pre-push" --sync "$@"
        ;;
    esac
  fi
  case "${1:-}" in
    --session) trigger=session; shift ;;
    --full) trigger=full; shift ;;
    --backfill) trigger=backfill; shift ;;
    "") trigger=manual ;;
    *) trigger=push ;;                 # from the git hook: <remote> <pushed sha>...
  esac
  git config --local --get caliber.mcpUrl >/dev/null 2>&1 || exit 0
  [ -f "$common/caliber/sync-token" ] || exit 0
  command -v python3 >/dev/null 2>&1 || exit 0
  if [ ! -f "$here/sync.py" ]; then
    printf '%s trigger=%s result=missing\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$trigger" \
      >>"$common/caliber/sync.log" 2>/dev/null
    exit 0
  fi
  cd "$root" || exit 0
  shallow=$(git rev-parse --git-path shallow 2>/dev/null) || shallow=""
  case "$shallow" in "" | /*) ;; *) shallow="$root/$shallow" ;; esac
  CALIBER_SYNC_TRIGGER=$trigger CALIBER_SYNC_STATE="$common/caliber" \
    CALIBER_SYNC_SHALLOW=$shallow sync_run "$@" </dev/null >/dev/null 2>&1
  exit 0
fi

if [ "${1:-}" = "--install" ]; then
  shift
  virtual=""
  session_only=""
  repository=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --virtual) virtual=1 ;;
      --session-only) session_only=1 ;;
      --repository)
        [ "$#" -ge 2 ] || { say "--repository needs host/owner/name"; exit 1; }
        repository=$2
        shift
        ;;
      *) say "unknown option: $1"; exit 1 ;;
    esac
    shift
  done
  if [ -n "$session_only" ] && [ -z "$virtual" ]; then
    say "not installed: --session-only is for a clone of a virtual repository (--virtual)"
    exit 1
  fi
  if [ -n "$virtual" ] && [ ! -f "$here/sync.py" ]; then
    say "not installed: $here/sync.py is missing"
    exit 1
  fi
  if [ -n "$repository" ] && ! printf '%s\n' "$repository" | grep -Eq '^[A-Za-z0-9.-]+(/[A-Za-z0-9._-]+){2,}$'; then
    say "not installed: --repository must be host/owner/name, as the remote names it"
    exit 1
  fi
  # The sync token comes on stdin, never as an argument (other users could read that).
  token=""
  if [ -n "$virtual" ] && [ ! -t 0 ]; then IFS= read -r token || :; fi
  case "$token" in
    "") ;;
    clb_*[!A-Za-z0-9_-]* | clb_) say "not installed: what came on stdin is no sync token"; exit 1 ;;
    clb_*) ;;
    *) say "not installed: what came on stdin is no sync token"; exit 1 ;;
  esac
  cd "$root" || exit 1
  command -v python3 >/dev/null 2>&1 || { say "python3 is needed"; exit 1; }
  # The endpoint your token goes to: a clone keeps the one it has until you change it.
  pinned=$(git config --local --get caliber.mcpUrl 2>/dev/null) || pinned=""
  if [ -n "$virtual" ]; then found=$(endpoint virtual); else found=$(endpoint); fi
  case "$found" in
    "bad-pin "*)
      say "not installed: this clone's caliber.mcpUrl must be an https URL without credentials (${found#bad-pin })"
      say "Set it to your Caliber's MCP address with git config --local caliber.mcpUrl, or unset it."
      exit 1
      ;;
    "config "*) url=${found#config } ;;
    "default "*) url=${pinned:-${found#default }} ;;
    "bad-env "*)
      if [ -z "$pinned" ]; then
        say "not installed: CALIBER_URL must be an https URL without credentials (${found#bad-env })"
        exit 1
      fi
      url=$pinned
      ;;
    *)
      say "not installed: no Caliber server (an https URL) in this repository's MCP configs; run /caliber:setup first"
      exit 1
      ;;
  esac
  if [ -n "$pinned" ] && [ "$pinned" != "$url" ]; then
    say "not changed: this clone reports to $pinned, and the repository's MCP config now names $url."
    say "If the new one is right, set caliber.mcpUrl to it with git config --local."
    exit 2
  fi
  hooks=$(git rev-parse --git-path hooks) || exit 1
  case "$hooks" in /*) ;; *) hooks="$root/$hooks" ;; esac
  # Husky: git runs stubs in .husky/_, which Husky rewrites; people's hooks are one up.
  case "$hooks" in */.husky/_) hooks=${hooks%/_} ;; esac
  hook="$hooks/pre-push"
  # own (in the git directory), versioned (in the working tree) or shared (outside the
  # repository: other repositories use it, so this install never writes there).
  common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P) || exit 1
  where=$(python3 -I -c '
import os, sys
hooks, common, root = (os.path.realpath(p) for p in sys.argv[1:4])
inside = lambda path, base: path == base or path.startswith(base + os.sep)
print("own" if inside(hooks, common) else "versioned" if inside(hooks, root) else "shared")
' "$hooks" "$common" "$root") || exit 1
  if [ -n "$virtual" ]; then
    # The token: in the git directory, never the working tree, readable by you alone.
    state_dir="$common/caliber"
    if [ -n "$token" ]; then
      mkdir -p "$state_dir" || exit 1
      (umask 077 && printf '%s\n' "$token" >"$state_dir/sync-token.new") || exit 1
      chmod 600 "$state_dir/sync-token.new" && mv -f "$state_dir/sync-token.new" "$state_dir/sync-token" || exit 1
    elif [ ! -f "$state_dir/sync-token" ]; then
      say "not installed: no sync token on stdin, and this clone has none (setup asks Caliber for one)"
      exit 1
    fi
    if [ -n "$session_only" ]; then
      git config --local caliber.mcpUrl "$url" || exit 1
      git config --local caliber.syncActivity true || exit 1
      [ -z "$repository" ] || git config --local caliber.syncRepository "$repository" || exit 1
      say "the activity sync is on for this clone, reporting to $url: at the start of each Claude Code session (off: git config --local caliber.syncActivity false)"
      exit 0
    fi
  fi
  # The hook files go to the git directory, where no checkout, merge or pull writes: a
  # branch may hold any .caliber/hooks/, and in a virtual clone git silently replaces
  # excluded files with tracked ones of the same path.
  installed="$common/caliber/hooks"
  if [ "$here" != "$installed" ]; then
    (umask 077 && mkdir -p "$installed") || exit 1
    # Optional: check-on-push.sh in a virtual clone (no check), sync.py in any other.
    for name in pre-push agent-post-push.sh check-on-push.sh sync.py; do
      if [ ! -f "$here/$name" ]; then
        [ "$name" = check-on-push.sh ] && [ -n "$virtual" ] && continue
        [ "$name" = sync.py ] && [ -z "$virtual" ] && continue
        say "not installed: $here/$name is missing"
        exit 1
      fi
      cp "$here/$name" "$installed/$name.new" && chmod 755 "$installed/$name.new" \
        && mv -f "$installed/$name.new" "$installed/$name" || exit 1
    done
  fi
  if [ -n "$virtual" ]; then
    # A virtual repository's versioned or shared hooks are the client's: never written to.
    if [ "$where" != own ]; then
      git config --local caliber.mcpUrl "$url" || exit 1
      git config --local caliber.syncActivity true || exit 1
      [ -z "$repository" ] || git config --local caliber.syncRepository "$repository" || exit 1
      say "the activity sync is on for this clone, reporting to $url; no hook was written ($hooks is the repository's or shared), so a push starts no sync: it runs at the start of a Claude Code session and by hand ($installed/pre-push --sync; --full sends the whole history). Off: git config --local caliber.syncActivity false"
      exit 0
    fi
  fi
  if [ "$where" != shared ]; then mkdir -p "$hooks" || exit 1; fi
  # A versioned hook's last line: it keeps the status of what ran before it and after a
  # success runs the git directory's copy (git runs hooks at the working tree's top).
  # shellcheck disable=SC2016
  line='caliber_rc=$?; if [ "$caliber_rc" -eq 0 ] && { [ "$(git config --local --type=bool --get caliber.checkOnPush 2>/dev/null)" = true ] || [ "$(git config --local --type=bool --get caliber.syncActivity 2>/dev/null)" = true ]; }; then caliber_hook="$(git rev-parse --git-common-dir)/caliber/hooks/pre-push"; if [ -x "$caliber_hook" ]; then "$caliber_hook" "$@" || true; else echo "Caliber: this hook ran no check or sync: this clone has no copy of Caliber'"'"'s hook in its git directory (run /caliber:setup again)" >&2; fi; fi; (exit "$caliber_rc") '"$MARK"
  state=$(CALIBER_LINE=$line keep "$hook" "$MARK" "$where") || exit 1
  case "$state" in
    created) say "the check on push was added: $hook" ;;
    wrapped) say "the check on push was added: $hook runs the hook that was there first (kept as pre-push.caliber-previous), then starts the check" ;;
    added)
      say "the check on push was added to $hook"
      # A hook switched off stays off: that was somebody's choice.
      [ -x "$hook" ] || say "that hook is not executable, so git does not run it (chmod +x turns it on)"
      ;;
    updated) say "the Caliber part of $hook was updated to this version" ;;
    already) say "the pre-push hook already has the Caliber line ($hook)" ;;
    *)
      case "$state" in
        shared) say "not installed: $hooks is outside this repository (core.hooksPath), so other repositories use it too; this install does not write there." ;;
        flow) say "not installed: $hook uses exec or exit, or ends mid-command, so a line added at its end might never run." ;;
        taken) say "not installed: $hook.caliber-previous is in the way." ;;
        itself) say "not installed: $hook asks for its own name or is no text, so it cannot be kept under another name." ;;
        special) say "not installed: $hook is not a regular file." ;;
        *) say "not installed: $hook is not a shell script." ;;
      esac
      if [ -n "$virtual" ]; then
        git config --local caliber.mcpUrl "$url" || exit 1
        git config --local caliber.syncActivity true || exit 1
        [ -z "$repository" ] || git config --local caliber.syncRepository "$repository" || exit 1
        say "No hook was written or changed; the activity sync is on for this clone and reports to $url: it runs at the start of a Claude Code session and by hand ($installed/pre-push --sync)."
        exit 0
      fi
      git config --local caliber.mcpUrl "$url" || exit 1
      git config --local caliber.checkOnPush true || exit 1
      say "No hook was written or changed; this clone is on (caliber.checkOnPush) and reports to $url."
      say "To start the check, add this to the pre-push hook as its last line, or just before a final exit that ends with the status of the command before it; never after an exec or exit (it keeps the result of what ran before it, and runs nothing in a clone that did not turn the check on):"
      say "  $line"
      exit 3
      ;;
  esac
  git config --local caliber.mcpUrl "$url" || exit 1
  if [ -n "$virtual" ]; then
    # No check for a virtual repository: caliber.checkOnPush stays as it is.
    git config --local caliber.syncActivity true || exit 1
    [ -z "$repository" ] || git config --local caliber.syncRepository "$repository" || exit 1
    say "the activity sync is on for this clone, reporting to $url: after each push and at the start of a Claude Code session (off: git config --local caliber.syncActivity false)"
    exit 0
  fi
  git config --local caliber.checkOnPush true || exit 1
  say "on for this clone, reporting to $url (off: git config --local caliber.checkOnPush false)"
  exit 0
fi

check_on=""
[ "$(git config --type=bool --get caliber.checkOnPush 2>/dev/null)" != "true" ] || check_on=1
sync_on=""
if [ "$(git config --local --type=bool --get caliber.syncActivity 2>/dev/null)" = true ]; then
  common=$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P) || common=""
  [ -z "$common" ] || [ ! -f "$common/caliber/sync-token" ] \
    || [ ! -x "$common/caliber/hooks/pre-push" ] || sync_on=1
fi
[ -n "$check_on$sync_on" ] || exit 0
# The git directory's copy says when the repository's hooks are newer (read, never run).
if [ -n "$check_on" ]; then
  tree=$(cd "$root" 2>/dev/null && pwd -P) || tree=""
  copy=$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P)/caliber/hooks
  version() { sed -n '2{s/.*caliber-hooks-version: \([0-9][0-9]*\).*/\1/p;q;}' "$1" 2>/dev/null; }
  case "$here/" in
    "$copy/")
      mine=$(version "$0")
      theirs=$(version "$root/.caliber/hooks/pre-push")
      if [ -n "$mine" ] && [ -n "$theirs" ] && [ "$theirs" -gt "$mine" ] 2>/dev/null; then
        say "this clone runs Caliber's hooks version $mine from its git directory, and the repository has version $theirs: run .caliber/hooks/pre-push --install to use them"
      fi
      ;;
    "$tree/"*)
      say "this clone's git hook runs the working tree's copy of this file, which the branch checked out can change: run .caliber/hooks/pre-push --install once more, so it runs a copy in the git directory"
      ;;
  esac
fi
remote=${1:-origin}
if [ -t 0 ]; then refs=""; else refs=$(cat); fi

# The sync runs detached: it waits for the push to end, never the other way round.
if [ -n "$sync_on" ] && command -v python3 >/dev/null 2>&1; then
  shas=$(pushed_shas)
  # shellcheck disable=SC2086 # the pushed shas: one word each
  CALIBER_SYNC_WAIT=$(pushing_git) nohup python3 -I -c 'import os, sys
try:
    os.setsid()
except OSError:
    pass
os.execv(sys.argv[1], sys.argv[1:])' \
    "$common/caliber/hooks/pre-push" --sync "$remote" $shas </dev/null >/dev/null 2>&1 &
fi
[ -n "$check_on" ] || exit 0

# Whether the plugin is on for the background check (installed and enabled for your user,
# the scope a headless run loads, not off here) and for a Claude Code session. From Claude
# Code's files; the CLI, slow to start, only when they are missing.
plugin_state() {
  python3 -I - "$root" 2>/dev/null <<'PY'
import json
import os
import subprocess
import sys

ID = "caliber@caliber"
home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")


def load(path):
    try:
        with open(path) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def enabled(settings):
    value = (settings or {}).get("enabledPlugins")
    value = value.get(ID) if isinstance(value, dict) else None
    return value if isinstance(value, bool) else None


installed = load(os.path.join(home, "plugins", "installed_plugins.json"))
user = load(os.path.join(home, "settings.json"))
if installed is None or user is None:
    # A push waits 3 seconds at most; no answer is off.
    try:
        out = subprocess.run(["claude", "plugin", "list", "--json"], capture_output=True,
                             text=True, timeout=3, stdin=subprocess.DEVNULL).stdout
        rows = json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        rows = []
    rows = [row for row in rows if isinstance(row, dict) and row.get("id") == ID
            and row.get("scope") == "user"] if isinstance(rows, list) else []
    present = bool(rows)
    mine = any(row.get("enabled") is True for row in rows)
else:
    entries = (installed.get("plugins") or {}).get(ID) \
        if isinstance(installed.get("plugins"), dict) else None
    if isinstance(entries, dict):
        entries = [entries]             # an older format: one user install
    present = isinstance(entries, list) and any(
        isinstance(entry, dict) and entry.get("scope", "user") == "user" for entry in entries)
    mine = enabled(user) is True
project = enabled(load(os.path.join(sys.argv[1], ".claude", "settings.json")))
local = enabled(load(os.path.join(sys.argv[1], ".claude", "settings.local.json")))
ready = present and mine and project is not False
session = present and (local if local is not None else project if project is not None
                       else mine) is True
print(("on" if ready else "off") + " " + ("on" if session else "off"))
PY
}
plugin=""
plugin_on() {
  if [ -z "$plugin" ]; then
    plugin=$(plugin_state) || plugin=""
    [ -n "$plugin" ] || plugin="off off"
  fi
  case "$1" in
    ready) [ "${plugin% *}" = on ] ;;
    *) [ "${plugin#* }" = on ] ;;
  esac
}

# An agent's push whose session hook runs the check itself.
covered() { [ -n "$1" ] && grep -qs 'agent-post-push.sh' "$root/$2"; }
in_session() {
  [ "$(git config --type=bool --get caliber.checkInSession 2>/dev/null)" != "false" ] || return 1
  covered "${CLAUDECODE:-}" .claude/settings.json ||
    covered "${CODEX_SANDBOX:-}" .codex/hooks.json ||
    covered "${CURSOR_AGENT:-}" .cursor/hooks.json ||
    covered "${GEMINI_CLI:-}" .gemini/settings.json ||
    { [ -n "${CLAUDECODE:-}" ] && command -v python3 >/dev/null 2>&1 && plugin_on session; }
}

# What the check needs, said once, on the first branch to check.
ready() {
  if ! command -v python3 >/dev/null 2>&1; then
    say "no check started: python3 is not installed"
  elif [ -z "${CALIBER_TOKEN:-}" ] && ! plugin_on ready; then
    say "no check started: install the Caliber plugin and sign in once, or export CALIBER_TOKEN"
  elif ! command -v claude >/dev/null 2>&1; then
    say "no check started: the claude CLI is not installed (npm i -g @anthropic-ai/claude-code)"
  elif [ ! -x "$here/check-on-push.sh" ]; then
    say "no check started: $here/check-on-push.sh is missing (run /caliber:setup)"
  else
    return 0
  fi
  return 1
}

default=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null) || default=""
default=${default#"$remote"/}

if [ -z "$refs" ]; then
  # Nothing on stdin (an earlier hook read it): the current branch, unless already pushed.
  current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
  head=$(git rev-parse HEAD) || exit 0
  [ "$(git rev-parse --verify --quiet "refs/remotes/$remote/$current" || true)" != "$head" ] || exit 0
  refs="refs/heads/$current $head refs/heads/$current -"
fi

printf '%s\n' "$refs" | while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # a tag, a note
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac          # a deleted branch
  branch=${remote_ref#refs/heads/}
  if [ -n "$default" ]; then
    [ "$branch" != "$default" ] || continue
  else
    case "$branch" in main | master) continue ;; esac
  fi
  if in_session; then
    say "no background check: the agent session that pushed runs the check (its Caliber session hook)"
    exit 0
  fi
  ready || exit 0
  # Its own session, so the push (and a Ctrl-C after it) leaves it running.
  nohup python3 -I -c 'import os, sys
try:
    os.setsid()
except OSError:
    pass
os.execv(sys.argv[1], sys.argv[1:])' \
    "$here/check-on-push.sh" "$branch" "$local_sha" "$remote" </dev/null >/dev/null 2>&1 &
done
exit 0
